# API
VITE_API_URL=http://localhost:8000/api/v1

# App
VITE_APP_NAME=Formativa
VITE_APP_DESCRIPTION=Plataforma de Certificación

# Contact
VITE_CONTACT_PHONE=+57 312 537 0218
VITE_CONTACT_EMAIL=contacto@formativa.com
VITE_CONTACT_CITY_COUNTRY=Bogotá, Colombia

# Features
VITE_SHOW_TEACHER_ROLE=False
VITE_HIDE_COURSES_FOR_ADMIN=True
VITE_DEFAULT_LOCALE=es-CO

# Pagination defaults
VITE_PAGE_SIZE=10

# Dominio raíz para subdominios de tenant ({tenant}.{ROOT_DOMAIN}); vacío = single
VITE_ROOT_DOMAIN=

# Pricing (solo visible en el dominio raíz). Montos totales facturados.
VITE_PRICING_CURRENCY=COP
VITE_PRICING_LOCALE=es-CO
VITE_PRICING_MONTHLY_TOTAL=149000
VITE_PRICING_SEMESTRAL_TOTAL=759900
VITE_PRICING_ANNUAL_TOTAL=1341000

# Cloudflare Turnstile (registro público). Obligatorio en producción.
VITE_TURNSTILE_SITE_KEY=

# Sentry (frontend). Dejar vacío para deshabilitar.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Sentry source maps (solo CI/build; no exponer en el frontend)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=cristhianquiza
SENTRY_PROJECT=
